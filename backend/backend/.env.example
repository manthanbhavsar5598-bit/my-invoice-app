# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas connection string recommended for production)
MONGO_URI=mongodb://127.0.0.1:27017/my-invoice-app

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# CORS - comma separated list of allowed origins (your deployed frontend URL(s))
CLIENT_ORIGIN=http://localhost:3000

# Email (used for sending invoices / password reset). Example uses Gmail SMTP or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="My Invoice App <no-reply@myinvoiceapp.com>"

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=200
